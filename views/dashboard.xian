{{> head}}
<body class="bg-gray-50">
  <div class="text-center mt-20">
    <h2 class="text-2xl">Dashboard</h2>
    <p class="mt-4">Welcome to your dashboard!</p>
    <div class="mt-6">
      <p id="logout-error" class="hidden mb-3 text-red-700" role="alert"></p>
      <button id="logout-button" type="button" class="text-red-600 font-medium">Logout</button>
    </div>
  </div>
  <script>
    document.getElementById("logout-button").addEventListener("click", async () => {
      const errorElement = document.getElementById("logout-error");
      errorElement.classList.add("hidden");

      try {
        const response = await fetch("/api/logout", { method: "POST" });
        const result = await response.json();

        if (!response.ok) {
          errorElement.textContent = result.message || "Logout failed.";
          errorElement.classList.remove("hidden");
          return;
        }

        window.location.assign("/login");
      } catch {
        errorElement.textContent = "Unable to log out. Please try again.";
        errorElement.classList.remove("hidden");
      }
    });
  </script>
{{> footer }}